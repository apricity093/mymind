# mymind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=mymind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 独立 embedding ───────────────────────────────────────────────────────────
# 模型留空：意图按 85/15 融合，知识库使用 MiniLM + BM25。
# 当前使用 Qwen Flash；密钥与聊天 LLM 分开配置。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_TOKENS=512
RAG_OVERLAP_TOKENS=0
RAG_EMBEDDING_QUERY_BUDGET_S=8
RAG_MAIN_VECTOR_WEIGHT=0.5
RAG_BACKUP_VECTOR_WEIGHT=0.5
INTENT_TEMPLATE_CACHE_PATH=./data/intent_templates.json
RAG_ONNX_PATH=./data/onnx_models
RAG_RERANK_MAX_CHARS=24000
RAG_RERANK_MAX_TOKENS=4096

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=mymind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
mymind_SKILLS_DIR=./skills
mymind_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true

# ── Agent Profile / Tool Use / Trace ─────────────────────────────────────────
AGENT_PROFILE_ENABLED=false
AGENT_TOOL_USE_ENABLED=true
AGENT_ESCALATION_ENABLED=false
AGENT_COMPOSER_ENABLED=false
AGENT_TRACE_ENABLED=false
TRACE_API_ENABLED=false
KNOWLEDGE_TOOL_MODE=tool_only
AGENT_MAX_TOOL_ROUNDS=3
MYMIND_MONITOR_FALLBACK_PENALTY=0.5
TRACE_KEY_PREFIX=mymind:trace
TRACE_TTL_SECONDS=86400
TRACE_MAX_ENTRIES=200
# MYMIND_GENERAL_MODEL=
# MYMIND_TECHNICAL_MODEL=
# MYMIND_BILLING_MODEL=
# MYMIND_COMPOSER_MODEL=
